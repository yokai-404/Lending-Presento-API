{
    "openapi": "3.0.0",
    "info": {
        "title": "Lending Presento API",
        "description": "Backend API для формы обратной связи с AI-интеграцией.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Local Development"
        }
    ],
    "paths": {
        "/api/contact": {
            "post": {
                "tags": [
                    "Contact Form"
                ],
                "summary": "Отправка формы обратной связи",
                "description": "Принимает данные формы, выполняет валидацию, AI-анализ комментария, сохраняет обращение и отправляет email уведомления.",
                "operationId": "createContact",
                "requestBody": {
                    "description": "Данные формы обратной связи",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "phone",
                                    "message"
                                ],
                                "properties": {
                                    "name": {
                                        "description": "Имя клиента",
                                        "type": "string",
                                        "example": "Иван Иванов"
                                    },
                                    "email": {
                                        "description": "Email клиента",
                                        "type": "string",
                                        "format": "email",
                                        "example": "ivan@example.com"
                                    },
                                    "phone": {
                                        "description": "Телефон клиента",
                                        "type": "string",
                                        "example": "+79991234567"
                                    },
                                    "message": {
                                        "description": "Комментарий клиента",
                                        "type": "string",
                                        "example": "Здравствуйте! Хотел бы заказать разработку сайта.",
                                        "minLength": 10
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Обращение успешно создано",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Ваше обращение успешно отправлено."
                                        },
                                        "data": {
                                            "properties": {
                                                "uuid": {
                                                    "type": "string",
                                                    "example": "019f9007-cbe3-7177-8773-73d19a1e86ac"
                                                },
                                                "created_at": {
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "example": "2026-07-24T05:59:58+03:00"
                                                },
                                                "ai_analysis": {
                                                    "description": "Результат AI анализа обращения",
                                                    "properties": {
                                                        "sentiment": {
                                                            "type": "string",
                                                            "example": "positive"
                                                        },
                                                        "category": {
                                                            "type": "string",
                                                            "example": "development"
                                                        },
                                                        "priority": {
                                                            "type": "string",
                                                            "example": "high"
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Введите корректный email."
                                        },
                                        "errors": {
                                            "type": "object",
                                            "example": {
                                                "email": [
                                                    "Введите корректный email."
                                                ],
                                                "phone": [
                                                    "Телефон слишком короткий."
                                                ]
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Превышен лимит запросов",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "message": "Too Many Requests"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "success": false,
                                    "message": "Произошла внутренняя ошибка сервера."
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/health": {
            "get": {
                "tags": [
                    "Health"
                ],
                "summary": "Проверка состояния сервиса",
                "description": "Возвращает статус приложения, базы данных, почты, AI-сервиса и версии окружения.",
                "operationId": "healthCheck",
                "responses": {
                    "200": {
                        "description": "Сервис работает",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "ok"
                                        },
                                        "service": {
                                            "properties": {
                                                "name": {
                                                    "type": "string",
                                                    "example": "Lending Presento API"
                                                },
                                                "version": {
                                                    "type": "string",
                                                    "example": "1.0.0"
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "services": {
                                            "type": "object"
                                        },
                                        "environment": {
                                            "type": "object"
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Ошибка проверки состояния сервиса"
                    }
                }
            }
        },
        "/api/metrics": {
            "get": {
                "tags": [
                    "Monitoring"
                ],
                "summary": "Получение статистики обращений",
                "description": "Возвращает агрегированную статистику по обращениям пользователей, включая количество обращений и AI-анализ сообщений.",
                "operationId": "metrics",
                "responses": {
                    "200": {
                        "description": "Статистика успешно получена",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "total_contacts": {
                                                    "description": "Общее количество обращений",
                                                    "type": "integer",
                                                    "example": 120
                                                },
                                                "today_contacts": {
                                                    "description": "Количество обращений за текущий день",
                                                    "type": "integer",
                                                    "example": 8
                                                },
                                                "positive": {
                                                    "description": "Количество позитивных сообщений",
                                                    "type": "integer",
                                                    "example": 70
                                                },
                                                "neutral": {
                                                    "description": "Количество нейтральных сообщений",
                                                    "type": "integer",
                                                    "example": 35
                                                },
                                                "negative": {
                                                    "description": "Количество негативных сообщений",
                                                    "type": "integer",
                                                    "example": 15
                                                },
                                                "categories": {
                                                    "description": "Распределение обращений по категориям",
                                                    "type": "object",
                                                    "example": {
                                                        "question": 55,
                                                        "order": 30,
                                                        "complaint": 12,
                                                        "other": 23
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Ошибка получения статистики",
                        "content": {
                            "application/json": {
                                "schema": {},
                                "example": {
                                    "success": false,
                                    "message": "Не удалось получить статистику обращений."
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Contact Form",
            "description": "API для отправки формы обратной связи с AI-анализом и email уведомлениями"
        },
        {
            "name": "Health",
            "description": "Проверка состояния API и зависимых сервисов"
        },
        {
            "name": "Monitoring",
            "description": "Системные эндпоинты"
        }
    ]
}